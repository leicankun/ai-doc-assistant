# MySQL 8.0.13+，先创建空的项目专用库和账号，参见 docs/mysql.md
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ai_doc_assistant
MYSQL_PASSWORD=replace_with_your_password
MYSQL_DATABASE=ai_doc_assistant

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Optional independent local BGE-M3 service; does not replace the API model.
BGE_MODEL_DIR=models/bge-m3
BGE_DEVICE=cuda
BGE_BATCH_SIZE=4
BGE_PORT=8001
BGE_BASE_URL=http://127.0.0.1:8001/v1
